{
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -c:*)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pip install:*)",
      "Bash(pip list:*)",
      "Bash(halfblood:*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(find *)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Edit(./docs/evidence/**)",
      "Edit(./examples/*.report.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Session paused — remember to run pytest before committing'",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "defaultMode": "plan",
  "env": {
    "MAX_THINKING_TOKENS": "32000"
  }
}
